{%- comment -%}
  Trust Badges section (v2)
  File name: sections/trust-badges.liquid
  Add it from: Online Store > Themes > Customize > Add section > "Trust Badges"
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} .tb-wrap {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  }
  #shopify-section-{{ section.id }} .tb-row {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr));
    align-items: start;
    column-gap: 24px;
    width: {{ section.settings.row_width }}%;
    max-width: none;
    margin: 0 auto;
    padding: 0;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .tb-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .tb-item svg.tb-icon {
    width: {{ section.settings.icon_size }}px !important;
    height: {{ section.settings.icon_size }}px !important;
    min-width: {{ section.settings.icon_size }}px;
    max-width: none;
    color: {{ section.settings.icon_color }};
    display: block;
    flex-shrink: 0;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .tb-item .tb-text {
    margin: 0;
    padding: 0;
    color: {{ section.settings.text_color }};
    font-family: inherit;
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: none;
    max-width: 100%;
    word-break: normal;
    overflow-wrap: break-word;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .tb-row {
      column-gap: 10px;
    }
    #shopify-section-{{ section.id }} .tb-item { gap: 8px; }
    #shopify-section-{{ section.id }} .tb-item svg.tb-icon {
      width: {{ section.settings.icon_size_mobile }}px !important;
      height: {{ section.settings.icon_size_mobile }}px !important;
      min-width: {{ section.settings.icon_size_mobile }}px;
    }
    #shopify-section-{{ section.id }} .tb-item .tb-text {
      font-size: {{ section.settings.font_size_mobile }}px;
      line-height: 1.3;
    }
  }
{%- endstyle -%}

<div class="tb-wrap">
  <div class="tb-row">
    {%- for block in section.blocks -%}
      <div class="tb-item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'lock' -%}
            <svg class="tb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="4.5" y="10" width="15" height="11" rx="3"/>
              <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
            </svg>
          {%- when 'document' -%}
            <svg class="tb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M14.5 21H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v8.5z"/>
              <path d="M14.5 21v-3.5a3 3 0 0 1 3-3H21"/>
              <path d="M7.5 8h9M7.5 12h5.5"/>
            </svg>
          {%- when 'truck' -%}
            <svg class="tb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M6.3 17.5H5.5V5.5h10v12"/>
              <path d="M10.7 17.5h4.8"/>
              <path d="M15.5 9h3.6l2.9 3.6v4.9h-1.7"/>
              <circle cx="8.5" cy="17.7" r="2.1"/>
              <circle cx="18" cy="17.7" r="2.1"/>
              <path d="M1 9.5h2.5M1.5 13h2"/>
            </svg>
          {%- when 'shield' -%}
            <svg class="tb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M12 2.5l8 3.2v6c0 4.8-3.3 8.6-8 9.8-4.7-1.2-8-5-8-9.8v-6z"/>
              <path d="M8.5 12l2.5 2.5 4.5-4.5"/>
            </svg>
          {%- when 'return' -%}
            <svg class="tb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M4 9h11a5.5 5.5 0 0 1 0 11H8"/>
              <path d="M8 4.5L3.5 9 8 13.5"/>
            </svg>
          {%- when 'heart' -%}
            <svg class="tb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M12 20.5S3 15.5 3 9.2A4.7 4.7 0 0 1 12 7a4.7 4.7 0 0 1 9 2.2c0 6.3-9 11.3-9 11.3z"/>
            </svg>
        {%- endcase -%}
        {%- if block.settings.text != blank -%}
          <p class="tb-text">{{ block.settings.text }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "class": "trust-badges-section",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#C8202F" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "color_background", "id": "background", "label": "Background" },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Text weight",
      "default": "600",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    { "type": "range", "id": "row_width", "label": "Row width", "min": 50, "max": 100, "step": 1, "unit": "%", "default": 90 },
    { "type": "header", "content": "Desktop" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 16, "max": 48, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "font_size", "label": "Text size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "header", "content": "Mobile" },
    { "type": "range", "id": "icon_size_mobile", "label": "Icon size", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "font_size_mobile", "label": "Text size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "lock",
          "options": [
            { "value": "lock", "label": "Lock" },
            { "value": "document", "label": "Document / Guarantee" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "return", "label": "Return arrow" },
            { "value": "heart", "label": "Heart" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Secure Payments" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "lock", "text": "Secure Payments" } },
        { "type": "badge", "settings": { "icon": "document", "text": "30-Day Money Back Guarantee" } },
        { "type": "badge", "settings": { "icon": "truck", "text": "Fast Shipping" } }
      ]
    }
  ]
}
{% endschema %}
