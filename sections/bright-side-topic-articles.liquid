{%- comment -%}
  File: sections/bright-side-topic-articles.liquid
  "Latest in [tag]" — grid of blog articles filtered by one tag.
  Heading left, article count right. Side spacing 5%.
{%- endcomment -%}

{%- liquid
  assign blog_obj = section.settings.blog
  if blog_obj == blank
    assign blog_obj = blogs.news
  endif

  assign tag = section.settings.filter_tag | strip
  assign tag_handle = tag | handleize
  assign limit = section.settings.posts_count

  comment
    Count posts with the tag (case-insensitive). If no tag is set,
    or no post has it, show ALL posts from the blog.
  endcomment
  assign use_filter = false
  assign total = 0
  if tag != blank
    for article in blog_obj.articles
      for t in article.tags
        assign t_handle = t | handleize
        if t_handle == tag_handle
          assign total = total | plus: 1
          break
        endif
      endfor
    endfor
    if total > 0
      assign use_filter = true
    endif
  endif
  unless use_filter
    assign total = blog_obj.articles_count
  endunless

  assign heading_name = tag
  if heading_name == blank
    assign heading_name = blog_obj.title
  endif
  assign heading = section.settings.heading | replace: '[tag]', heading_name
-%}

<style>
  #TopicArticles-{{ section.id }} {
    --tar-bg: {{ section.settings.bg_color }};
    --tar-card: {{ section.settings.card_color }};
    --tar-heading: {{ section.settings.heading_color }};
    --tar-text: {{ section.settings.text_color }};
    --tar-pill-bg: {{ section.settings.pill_bg }};
    --tar-pill-dot: {{ section.settings.pill_dot }};
    --tar-cols: {{ section.settings.columns }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<section id="TopicArticles-{{ section.id }}" class="topic-articles">

  {%- comment -%} Decorative doodles (client elements) {%- endcomment -%}
  {%- if section.settings.show_doodles -%}
    <div class="topic-articles__doodles" aria-hidden="true">
      <img class="topic-articles__doodle topic-articles__doodle--star" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_58.png?v=1793080282&width=140" alt="" width="140" height="140" loading="lazy">
      <img class="topic-articles__doodle topic-articles__doodle--squiggle" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_60.png?v=1793080282&width=120" alt="" width="120" height="120" loading="lazy">
      <img class="topic-articles__doodle topic-articles__doodle--curve" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_59.png?v=1793080283&width=120" alt="" width="120" height="120" loading="lazy">
    </div>
  {%- endif -%}

  <div class="topic-articles__inner">

    <header class="topic-articles__header">
      {%- if heading != blank -%}
        <h2 class="topic-articles__heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if section.settings.show_count and total > 0 -%}
        <p class="topic-articles__count">{{ total }} {% if total == 1 %}article{% else %}articles{% endif %}</p>
      {%- endif -%}
    </header>

    <div class="topic-articles__grid">
      {%- assign shown = 0 -%}
      {%- for article in blog_obj.articles -%}
        {%- if shown >= limit -%}{%- break -%}{%- endif -%}

        {%- if use_filter -%}
          {%- assign match = false -%}
          {%- for t in article.tags -%}
            {%- assign t_handle = t | handleize -%}
            {%- if t_handle == tag_handle -%}{%- assign match = true -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
          {%- unless match -%}{%- continue -%}{%- endunless -%}
        {%- endif -%}

        {%- liquid
          assign card_tag = tag
          if card_tag == blank and article.tags.size > 0
            assign card_tag = article.tags.first
          endif
        -%}

        {%- liquid
          assign shown = shown | plus: 1
          assign words = article.content | strip_html | split: ' ' | size
          assign read_time = words | divided_by: 200 | at_least: 1
        -%}

        <article class="topic-articles__card">
          <a href="{{ article.url }}" class="topic-articles__media" aria-label="{{ article.title | escape }}">
            {%- if article.image -%}
              {{ article.image | image_url: width: 800 | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800',
                sizes: '(min-width: 990px) 30vw, (min-width: 600px) 45vw, 90vw',
                alt: article.image.alt | default: article.title | escape
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'topic-articles__placeholder' }}
            {%- endif -%}
          </a>

          <div class="topic-articles__body">
            {%- if card_tag != blank -%}
              <span class="topic-articles__pill">
                <span class="topic-articles__dot" aria-hidden="true"></span>
                {{ card_tag }}
              </span>
            {%- endif -%}

            <h3 class="topic-articles__title">
              <a href="{{ article.url }}">{{ article.title | escape }}</a>
            </h3>

            {%- if section.settings.show_excerpt -%}
              <p class="topic-articles__excerpt">
                {%- if article.excerpt != blank -%}
                  {{ article.excerpt | strip_html | truncatewords: 14 }}
                {%- else -%}
                  {{ article.content | strip_html | truncatewords: 14 }}
                {%- endif -%}
              </p>
            {%- endif -%}

            <p class="topic-articles__meta">{{ read_time }} min read</p>
          </div>
        </article>
      {%- endfor -%}

      {%- if shown == 0 -%}
        {%- if request.design_mode -%}
          {%- for i in (1..6) -%}
            <article class="topic-articles__card">
              <div class="topic-articles__media">{{ 'lifestyle-1' | placeholder_svg_tag: 'topic-articles__placeholder' }}</div>
              <div class="topic-articles__body">
                <span class="topic-articles__pill"><span class="topic-articles__dot"></span>{{ tag | default: 'Tag' }}</span>
                <h3 class="topic-articles__title">Article title</h3>
                <p class="topic-articles__excerpt">Choose a blog and make sure posts have the "{{ tag }}" tag.</p>
                <p class="topic-articles__meta">5 min read</p>
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          <p class="topic-articles__empty">{{ section.settings.empty_text }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank and total > shown -%}
      <div class="topic-articles__footer">
        <a href="{{ blog_obj.url }}{% if use_filter %}/tagged/{{ tag_handle }}{% endif %}" class="topic-articles__btn">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .topic-articles { background: var(--tar-bg); }
  .topic-articles__inner {
    padding-left: 5%;
    padding-right: 5%;
  }

  /* Header */
  .topic-articles__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
  }
  .topic-articles__heading {
    margin: 0;
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.3px;
    color: var(--tar-heading);
  }
  .topic-articles__count {
    margin: 0;
    flex-shrink: 0;
    font-size: 12px;
    color: var(--tar-text);
    opacity: 0.8;
  }

  /* Grid */
  .topic-articles__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 600px) {
    .topic-articles__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 990px) {
    .topic-articles__grid {
      grid-template-columns: repeat(var(--tar-cols), minmax(0, 1fr));
      gap: 28px;
    }
  }

  /* Card */
  .topic-articles__card {
    display: flex;
    flex-direction: column;
    background: var(--tar-card);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .topic-articles__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.1);
  }

  .topic-articles__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f1efeb;
  }
  .topic-articles__media img,
  .topic-articles__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .topic-articles__card:hover .topic-articles__media img { transform: scale(1.05); }

  .topic-articles__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 16px 18px 20px;
  }

  .topic-articles__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    margin-bottom: 14px;
    background: var(--tar-pill-bg);
    color: var(--tar-heading);
    border-radius: 999px;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    line-height: 1;
  }
  .topic-articles__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tar-pill-dot);
  }

  .topic-articles__title {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.35;
    color: var(--tar-heading);
  }
  .topic-articles__title a { color: inherit; text-decoration: none; }
  .topic-articles__title a:hover { color: var(--tar-pill-dot); }

  .topic-articles__excerpt {
    margin: 0 0 18px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--tar-text);
  }
  .topic-articles__meta {
    margin: auto 0 0;
    font-size: 11px;
    font-weight: 700;
    color: var(--tar-text);
    opacity: 0.85;
  }

  .topic-articles__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 40px 0;
    color: var(--tar-text);
  }

  .topic-articles__footer { text-align: center; margin-top: 36px; }
  .topic-articles__btn {
    display: inline-block;
    padding: 14px 28px;
    background: var(--tar-pill-dot);
    color: #fff;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .topic-articles__btn:hover { color: #fff; transform: translateY(-2px); }

  /* ---------- Decorative doodles (sit in the 5% side space) ---------- */
  .topic-articles { position: relative; overflow: hidden; }
  .topic-articles__inner { position: relative; z-index: 1; }
  .topic-articles__doodles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .topic-articles__doodle {
    position: absolute;
    height: auto;
    display: block;
    user-select: none;
  }
  .topic-articles__doodle--star     { top: 14px;   left: 1%;  width: 44px; rotate: -12deg; }
  .topic-articles__doodle--squiggle { top: 42%;    right: 1%; width: 34px; rotate: 10deg; }
  .topic-articles__doodle--curve    { bottom: 8%;  left: 1.4%; width: 28px; rotate: -18deg; }

  @media (max-width: 1199px) {
    .topic-articles__doodle--squiggle,
    .topic-articles__doodle--curve { display: none; }
    .topic-articles__doodle--star { top: 10px; left: 1%; width: 34px; }
  }
  @media (max-width: 749px) {
    .topic-articles__doodle--star { top: 8px; left: auto; right: 4%; width: 28px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .topic-articles__doodle {
      animation: topicArticlesDoodle 6s ease-in-out infinite;
    }
    .topic-articles__doodle--squiggle { animation-delay: -2s; }
    .topic-articles__doodle--curve    { animation-delay: -4s; }
  }
  @keyframes topicArticlesDoodle {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Topic articles",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Articles" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "filter_tag", "label": "Show posts with tag", "info": "Optional, e.g. Good Moods. Leave empty to show all posts from the blog." },
    { "type": "range", "id": "posts_count", "label": "Number of posts", "min": 3, "max": 24, "step": 1, "default": 6 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest in [tag]", "info": "[tag] is replaced with the tag name" },
    { "type": "checkbox", "id": "show_count", "label": "Show article count", "default": true },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "\"View all\" label", "default": "View all articles", "info": "Shows only when there are more posts than displayed" },
    { "type": "text", "id": "empty_text", "label": "No posts message", "default": "New stories are coming soon." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#F6F4F1" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1F1F1F" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#555555" },
    { "type": "color", "id": "pill_bg", "label": "Tag background", "default": "#DDF2F1" },
    { "type": "color", "id": "pill_dot", "label": "Tag dot & accent", "default": "#3FB8B2" },

    { "type": "header", "content": "Decoration" },
    { "type": "checkbox", "id": "show_doodles", "label": "Show decorative doodles", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    { "name": "Topic articles" }
  ]
}
{% endschema %}