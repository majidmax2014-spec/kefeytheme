{%- comment -%}
  File: sections/kefey-article.liquid
  Kefey article page:
  hero + cover image + sticky table of contents (auto from H2s)
  + styled article content + author box + disclaimer + related posts.
{%- endcomment -%}

{%- liquid
  assign a = article
  assign words = a.content | strip_html | split: ' ' | size
  assign read_time = words | divided_by: 200 | at_least: 1
  assign main_tag = a.tags.first

  assign author_name = section.settings.author_name
  if author_name == blank
    assign author_name = a.author
  endif
-%}

<style>
  #KA-{{ section.id }} {
    --ka-accent: {{ section.settings.accent_color }};
    --ka-hero-bg: {{ section.settings.hero_bg }};
    --ka-hero-text: {{ section.settings.hero_text }};
    --ka-heading: {{ section.settings.heading_color }};
    --ka-text: {{ section.settings.text_color }};
    --ka-soft: {{ section.settings.related_bg }};
    --ka-offset: {{ section.settings.sticky_offset }}px;
  }
</style>

<div id="KA-{{ section.id }}" class="ka">

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  <header class="ka-hero{% if a.image %} ka-hero--has-cover{% endif %}">
    <svg class="ka-hero__star ka-hero__star--l" viewBox="0 0 100 95" aria-hidden="true"><path d="M50 0 L61.8 35.3 L99 36.3 L69.1 58.7 L79.4 94.4 L50 73.1 L20.6 94.4 L30.9 58.7 L1 36.3 L38.2 35.3 Z"/></svg>
    <svg class="ka-hero__star ka-hero__star--r" viewBox="0 0 100 95" aria-hidden="true"><path d="M50 0 L61.8 35.3 L99 36.3 L69.1 58.7 L79.4 94.4 L50 73.1 L20.6 94.4 L30.9 58.7 L1 36.3 L38.2 35.3 Z"/></svg>

    <div class="ka-hero__inner">
      <nav class="ka-crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <a href="{{ blog.url }}">{{ blog.title }}</a>
        {%- if main_tag != blank -%}
          <span aria-hidden="true">/</span>
          <a href="{{ blog.url }}/tagged/{{ main_tag | handleize }}">{{ main_tag }}</a>
        {%- endif -%}
      </nav>

      {%- if main_tag != blank -%}
        <span class="ka-pill">{{ main_tag }}</span>
      {%- endif -%}

      <h1 class="ka-hero__title">{{ a.title | escape }}</h1>

      {%- if a.excerpt != blank -%}
        <div class="ka-hero__excerpt">{{ a.excerpt | strip_html | truncatewords: 40 }}</div>
      {%- endif -%}

      <p class="ka-hero__meta">
        <span>By {{ author_name }}</span>
        <span aria-hidden="true">·</span>
        <span>{{ a.published_at | date: '%-d %B %Y' }}</span>
        <span aria-hidden="true">·</span>
        <span>{{ read_time }} min read</span>
      </p>
    </div>
  </header>

  {%- comment -%} ---------- COVER IMAGE ---------- {%- endcomment -%}
  {%- if a.image -%}
    <figure class="ka-cover">
      <img
        src="{{ a.image | image_url: width: 1600 }}"
        srcset="{{ a.image | image_url: width: 900 }} 900w, {{ a.image | image_url: width: 1600 }} 1600w, {{ a.image | image_url: width: 2200 }} 2200w"
        sizes="(min-width: 990px) 900px, 92vw"
        alt="{{ a.image.alt | default: a.title | escape }}"
        width="{{ a.image.width }}"
        height="{{ a.image.height }}"
        fetchpriority="high"
      >
      {%- if a.image.alt != blank -%}
        <figcaption>{{ a.image.alt }}</figcaption>
      {%- endif -%}
    </figure>
  {%- endif -%}

  {%- comment -%} ---------- BODY: sticky TOC + content ---------- {%- endcomment -%}
  <div class="ka-layout">

    <aside class="ka-toc" data-toc-wrap>
      <ka-toc>
        <details class="ka-toc__box" data-toc-details>
          <summary class="ka-toc__label">
            {{ section.settings.toc_label }}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <ol class="ka-toc__list" data-toc-list></ol>
        </details>
      </ka-toc>
    </aside>

    <div class="ka-main">
      <div class="ka-content" data-article-content>
        {{ a.content }}
      </div>

      {%- if section.settings.show_author -%}
        <div class="ka-author">
          {%- if section.settings.author_image != blank -%}
            {{ section.settings.author_image | image_url: width: 200 | image_tag: class: 'ka-author__img', loading: 'lazy', alt: author_name }}
          {%- endif -%}
          <div>
            <p class="ka-author__name">{{ author_name }}</p>
            {%- if section.settings.author_bio != blank -%}
              <div class="ka-author__bio">{{ section.settings.author_bio }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.disclaimer != blank -%}
        <div class="ka-disclaimer">{{ section.settings.disclaimer }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ---------- RELATED POSTS (same first tag) ---------- {%- endcomment -%}
  {%- if section.settings.show_related and main_tag != blank -%}
    {%- assign related_count = 0 -%}
    {%- capture related_cards -%}
      {%- for post in blog.articles limit: 30 -%}
        {%- if post.id == a.id -%}{%- continue -%}{%- endif -%}
        {%- if post.tags contains main_tag -%}
          {%- assign related_count = related_count | plus: 1 -%}
          {%- assign p_words = post.content | strip_html | split: ' ' | size -%}
          {%- assign p_read = p_words | divided_by: 200 | at_least: 1 -%}
          <a href="{{ post.url }}" class="ka-rel__card">
            <div class="ka-rel__media">
              {%- if post.image -%}
                <img src="{{ post.image | image_url: width: 900 }}" alt="{{ post.image.alt | default: post.title | escape }}" width="{{ post.image.width }}" height="{{ post.image.height }}" loading="lazy">
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'ka-rel__placeholder' }}
              {%- endif -%}
            </div>
            <div class="ka-rel__body">
              <span class="ka-rel__pill"><span aria-hidden="true">★</span> {{ main_tag }}</span>
              <h3 class="ka-rel__title">{{ post.title | escape }}</h3>
              <p class="ka-rel__excerpt">{{ post.excerpt | default: post.content | strip_html | truncatewords: 12 }}</p>
              <p class="ka-rel__meta">{{ p_read }} min read</p>
            </div>
          </a>
          {%- if related_count >= 3 -%}{%- break -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if related_count > 0 -%}
      <section class="ka-rel">
        <div class="ka-rel__inner">
          <div class="ka-rel__head">
            <h2 class="ka-rel__heading">More from {{ main_tag }}</h2>
            <a class="ka-rel__all" href="{{ blog.url }}/tagged/{{ main_tag | handleize }}">More in {{ main_tag }} →</a>
          </div>
          <div class="ka-rel__grid">{{ related_cards }}</div>
        </div>
      </section>
    {%- endif -%}
  {%- endif -%}
</div>

{% javascript %}
  if (!customElements.get('ka-toc')) {
    customElements.define('ka-toc', class extends HTMLElement {
      connectedCallback() {
        const root = this.closest('.ka');
        const content = root && root.querySelector('[data-article-content]');
        const list = this.querySelector('[data-toc-list]');
        this.details = this.querySelector('[data-toc-details]');
        if (!content || !list) return;

        const headings = Array.from(content.querySelectorAll('h2'));
        if (!headings.length) {
          const wrap = this.closest('[data-toc-wrap]');
          if (wrap) wrap.style.display = 'none';
          return;
        }

        const used = {};
        this.links = headings.map((h) => {
          let id = h.id || h.textContent.trim().toLowerCase()
            .replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').slice(0, 60) || 'section';
          if (used[id]) { used[id] += 1; id = id + '-' + used[id]; } else { used[id] = 1; }
          h.id = id;

          const li = document.createElement('li');
          const link = document.createElement('a');
          link.href = '#' + id;
          link.textContent = h.textContent.trim();
          link.addEventListener('click', (e) => {
            e.preventDefault();
            h.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.replaceState(null, '', '#' + id);
            if (!this.mq.matches) this.details.open = false;
          });
          li.appendChild(link);
          list.appendChild(li);
          return { h, link };
        });

        /* Desktop: always open. Mobile: collapsible */
        this.mq = window.matchMedia('(min-width: 990px)');
        const sync = () => { this.details.open = this.mq.matches; };
        sync();
        this.mq.addEventListener('change', sync);

        /* Highlight the section being read */
        const setActive = (id) => {
          this.links.forEach(({ h, link }) => link.classList.toggle('is-active', h.id === id));
        };
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => { if (en.isIntersecting) setActive(en.target.id); });
        }, { rootMargin: '-120px 0px -65% 0px' });
        headings.forEach((h) => io.observe(h));
        setActive(headings[0].id);
      }
    });
  }
{% endjavascript %}

{% stylesheet %}
  .ka { color: var(--ka-text); }

  /* ================= HERO ================= */
  .ka-hero {
    position: relative;
    overflow: hidden;
    background: var(--ka-hero-bg);
    color: var(--ka-hero-text);
    text-align: center;
    padding: 56px 5% 64px;
  }
  .ka-hero--has-cover { padding-bottom: 150px; }
  .ka-hero__star {
    position: absolute;
    fill: rgba(255, 255, 255, 0.22);
    pointer-events: none;
  }
  .ka-hero__star--l { top: 18px; left: 3%; width: 46px; }
  .ka-hero__star--r { top: 46%; right: 5%; width: 64px; rotate: 14deg; }

  .ka-hero__inner { position: relative; max-width: 720px; margin: 0 auto; }

  .ka-crumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-bottom: 16px;
    font-size: 12px;
    font-weight: 600;
    opacity: 0.9;
  }
  .ka-crumbs a { color: inherit; text-decoration: none; }
  .ka-crumbs a:hover { text-decoration: underline; }

  .ka-pill {
    display: inline-block;
    padding: 6px 14px;
    margin-bottom: 18px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ka-accent);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ka-hero__title {
    margin: 0 0 16px;
    color: inherit;
    font-size: clamp(30px, 5vw, 54px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .ka-hero__excerpt {
    max-width: 560px;
    margin: 0 auto 18px;
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.6;
  }
  .ka-hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0;
    font-size: 13px;
    font-weight: 700;
  }

  /* ================= COVER ================= */
  .ka-cover {
    position: relative;
    z-index: 1;
    width: 90%;
    max-width: 900px;
    margin: -110px auto 0;
  }
  .ka-cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    display: block;
    border-radius: 22px;
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.15);
  }
  .ka-cover figcaption {
    margin-top: 10px;
    text-align: center;
    font-size: 12px;
    color: var(--ka-text);
    opacity: 0.8;
  }

  /* ================= LAYOUT ================= */
  .ka-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    max-width: 1060px;
    margin: 0 auto;
    padding: 40px 5% 64px;
  }
  @media (min-width: 990px) {
    .ka-layout {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 56px;
      padding-top: 56px;
    }
  }
  .ka-main { min-width: 0; max-width: 720px; }

  /* ================= STICKY TOC ================= */
  .ka-toc { min-width: 0; }
  @media (min-width: 990px) {
    .ka-toc ka-toc {
      display: block;
      position: sticky;
      top: var(--ka-offset);
    }
  }
  .ka-toc__box {
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    padding: 16px 18px;
    background: #fff;
  }
  .ka-toc__label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    cursor: pointer;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ka-heading);
  }
  .ka-toc__label::-webkit-details-marker { display: none; }
  .ka-toc__label svg { transition: transform 0.25s ease; }
  .ka-toc__box[open] .ka-toc__label svg { transform: rotate(180deg); }
  @media (min-width: 990px) {
    .ka-toc__box { border: 0; padding: 0; background: transparent; }
    .ka-toc__label { cursor: default; pointer-events: none; }
    .ka-toc__label svg { display: none; }
  }

  .ka-toc__list {
    counter-reset: toc;
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }
  .ka-toc__list li { counter-increment: toc; }
  .ka-toc__list a {
    display: flex;
    gap: 8px;
    padding: 7px 0 7px 12px;
    border-left: 2px solid rgba(0, 0, 0, 0.08);
    font-size: 13px;
    line-height: 1.4;
    color: var(--ka-text);
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .ka-toc__list a::before {
    content: counter(toc) ".";
    font-weight: 700;
    opacity: 0.6;
  }
  .ka-toc__list a:hover { color: var(--ka-accent); }
  .ka-toc__list a.is-active {
    color: var(--ka-accent);
    border-left-color: var(--ka-accent);
    font-weight: 700;
  }

  /* ================= ARTICLE CONTENT ================= */
  .ka-content { font-size: 16px; line-height: 1.75; color: var(--ka-text); }
  .ka-content > *:first-child { margin-top: 0; }
  .ka-content p { margin: 0 0 18px; }
  .ka-content a { color: var(--ka-accent); }
  .ka-content strong { color: var(--ka-heading); }

  .ka-content h2 {
    margin: 44px 0 14px;
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ka-heading);
    scroll-margin-top: calc(var(--ka-offset) + 10px);
  }
  .ka-content h3 {
    margin: 28px 0 10px;
    font-size: 19px;
    font-weight: 800;
    color: var(--ka-heading);
  }
  .ka-content ul, .ka-content ol { margin: 0 0 18px; padding-left: 22px; }
  .ka-content li { margin-bottom: 8px; }
  .ka-content li::marker { color: var(--ka-accent); }

  .ka-content img { max-width: 100%; height: auto; border-radius: 16px; }
  .ka-content figure { margin: 28px 0; }
  .ka-content figure img { width: 100%; display: block; object-fit: cover; }
  .ka-content figcaption { margin-top: 8px; font-size: 12px; opacity: 0.75; }

  .ka-label {
    margin: 0 0 8px !important;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* In short (teal) */
  .ka-inshort {
    margin: 0 0 32px;
    padding: 22px 24px;
    background: #E1F4F3;
    border-radius: 16px;
  }
  .ka-inshort .ka-label { color: #2A9D97; }
  .ka-inshort p:last-child { margin-bottom: 0; }

  /* Two images side by side */
  .ka-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 28px 0;
  }
  .ka-images figure { margin: 0; }
  .ka-images img { aspect-ratio: 1 / 1.05; }
  @media (max-width: 599px) {
    .ka-images { grid-template-columns: 1fr; }
  }

  /* Worth knowing (yellow) */
  .ka-note {
    margin: 28px 0;
    padding: 18px 22px;
    background: #FFF8E1;
    border: 1px solid #FBE7A1;
    border-radius: 14px;
    font-size: 14.5px;
  }
  .ka-note .ka-label { color: #B88A00; }
  .ka-note p:last-child { margin-bottom: 0; }

  /* Pull quote */
  .ka-quote {
    margin: 32px 0;
    padding: 4px 0 4px 20px;
    border-left: 4px solid var(--ka-accent);
    color: var(--ka-accent);
    font-size: clamp(19px, 2vw, 23px);
    font-weight: 800;
    line-height: 1.35;
  }
  .ka-quote p { margin: 0; }

  /* Key takeaways */
  .ka-takeaways {
    margin: 32px 0;
    padding: 22px 26px;
    background: #FFF6D9;
    border: 2px solid #FFC700;
    border-radius: 18px;
  }
  .ka-takeaways .ka-label { color: var(--ka-heading); }
  .ka-takeaways ul { margin: 0; }
  .ka-takeaways li { margin-bottom: 6px; }

  /* Tables */
  .ka-content table {
    width: 100%;
    margin: 24px 0 28px;
    border-collapse: collapse;
    font-size: 14px;
  }
  .ka-content th {
    padding: 12px 14px;
    text-align: left;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ka-heading);
    border-bottom: 2px solid var(--ka-heading);
  }
  .ka-content td {
    padding: 14px;
    vertical-align: top;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .ka-content td:first-child { font-weight: 700; color: var(--ka-heading); }
  @media (max-width: 749px) {
    .ka-content table { display: block; overflow-x: auto; white-space: nowrap; }
    .ka-content td, .ka-content th { white-space: normal; min-width: 150px; }
  }

  /* CTA box */
  .ka-cta {
    margin: 36px 0;
    padding: 28px 28px 30px;
    background: var(--ka-accent);
    color: #fff;
    border-radius: 20px;
  }
  .ka-cta h3 { margin: 0 0 8px; color: #fff; font-size: 21px; }
  .ka-cta p { margin: 0 0 18px; font-size: 14.5px; }
  .ka-cta strong { color: #fff; }
  .ka-content .ka-btn {
    display: inline-block;
    padding: 12px 22px;
    background: #fff;
    color: var(--ka-accent);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .ka-content .ka-btn:hover { opacity: 0.9; }

  /* Keep exploring: two CTA cards */
  .ka-explore {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin: 28px 0 8px;
  }
  @media (min-width: 750px) {
    .ka-explore { grid-template-columns: 1fr 1fr; }
  }
  .ka-explore .ka-cta { margin: 0; display: flex; flex-direction: column; align-items: flex-start; }
  .ka-explore .ka-cta p { flex: 1; }
  .ka-explore .ka-cta--teal { background: #3FB8B2; }
  .ka-explore .ka-cta--teal .ka-btn { color: #2A9D97; }

  /* Ingredients grid */
  .ka-ingredients {
    margin: 32px 0;
    padding: 26px 22px;
    background: #FFF8EE;
    border-radius: 20px;
    text-align: center;
  }
  .ka-ingredients h3 { margin: 0 0 4px; }
  .ka-ingredients > p { margin: 0 0 20px; font-size: 13px; opacity: 0.8; }
  .ka-ingredients ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 20px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ka-ingredients li { margin: 0; font-size: 12.5px; font-weight: 700; color: var(--ka-heading); }
  .ka-ingredients li::marker { content: ''; }
  .ka-ingredients img {
    width: 72px;
    height: 72px;
    margin: 0 auto 8px;
    display: block;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid #fff;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.1);
  }
  .ka-ingredients li.is-star { color: var(--ka-accent); }
  .ka-ingredients li.is-star img { border-color: var(--ka-accent); }

  /* FAQ accordion */
  .ka-content details.ka-faq {
    margin: 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  .ka-content details.ka-faq:first-of-type { border-top: 1px solid rgba(0, 0, 0, 0.1); }
  .ka-content details.ka-faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 4px;
    list-style: none;
    cursor: pointer;
    font-size: 15.5px;
    font-weight: 700;
    color: var(--ka-heading);
  }
  .ka-content details.ka-faq summary::-webkit-details-marker { display: none; }
  .ka-content details.ka-faq summary::after {
    content: '+';
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #FDE4DF;
    color: var(--ka-accent);
    font-size: 18px;
    font-weight: 800;
    transition: transform 0.25s ease;
  }
  .ka-content details.ka-faq[open] summary::after { transform: rotate(45deg); }
  .ka-content details.ka-faq[open] {
    background: #FFF8EE;
    border-radius: 14px;
    border-color: transparent;
  }
  .ka-content details.ka-faq[open] summary { padding-left: 16px; padding-right: 16px; }
  .ka-content details.ka-faq > *:not(summary) { margin: 0; padding: 0 16px 18px; font-size: 14.5px; }

  /* Author box */
  .ka-author {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 44px;
    padding: 20px 22px;
    background: #FFF8EE;
    border-radius: 18px;
  }
  .ka-author__img {
    flex: 0 0 auto;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
  }
  .ka-author__name { margin: 0 0 4px; font-weight: 800; color: var(--ka-heading); }
  .ka-author__bio { font-size: 13px; line-height: 1.6; }
  .ka-author__bio p { margin: 0; }

  .ka-disclaimer {
    margin-top: 24px;
    font-size: 11.5px;
    line-height: 1.6;
    opacity: 0.7;
  }
  .ka-disclaimer p { margin: 0; }

  /* ================= RELATED ================= */
  .ka-rel { background: var(--ka-soft); padding: 56px 0 64px; }
  .ka-rel__inner { padding: 0 5%; max-width: 1100px; margin: 0 auto; }
  .ka-rel__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }
  .ka-rel__heading {
    margin: 0;
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 800;
    color: var(--ka-heading);
  }
  .ka-rel__all {
    font-size: 13px;
    font-weight: 800;
    color: var(--ka-accent);
    text-decoration: none;
  }
  .ka-rel__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 750px) {
    .ka-rel__grid { grid-template-columns: repeat(3, 1fr); }
  }
  .ka-rel__card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    color: var(--ka-heading);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.25s ease;
  }
  .ka-rel__card:hover { box-shadow: 0 16px 34px rgba(0, 0, 0, 0.12); color: var(--ka-heading); }
  .ka-rel__media { aspect-ratio: 4 / 3; overflow: hidden; }
  .ka-rel__media img, .ka-rel__placeholder { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ka-rel__body { flex: 1; display: flex; flex-direction: column; align-items: flex-start; padding: 18px 18px 20px; }
  .ka-rel__pill {
    padding: 5px 10px;
    margin-bottom: 10px;
    background: #FDE4DF;
    color: var(--ka-accent);
    border-radius: 999px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ka-rel__title { margin: 0 0 8px; font-size: 16.5px; font-weight: 800; line-height: 1.3; color: inherit; }
  .ka-rel__excerpt { margin: 0 0 12px; font-size: 13px; line-height: 1.6; color: var(--ka-text); }
  .ka-rel__meta { margin: auto 0 0; font-size: 11.5px; color: var(--ka-text); opacity: 0.8; }
{% endstylesheet %}

{% schema %}
{
  "name": "Kefey article page",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Table of contents" },
    { "type": "text", "id": "toc_label", "label": "Sidebar title", "default": "On this page" },
    { "type": "range", "id": "sticky_offset", "label": "Sticky top offset", "min": 0, "max": 200, "step": 5, "unit": "px", "default": 110, "info": "Increase if your sticky header covers the sidebar" },

    { "type": "header", "content": "Author" },
    { "type": "checkbox", "id": "show_author", "label": "Show author box", "default": true },
    { "type": "text", "id": "author_name", "label": "Author name", "default": "The Kefey® team", "info": "Leave empty to use the post author" },
    { "type": "image_picker", "id": "author_image", "label": "Author image" },
    { "type": "richtext", "id": "author_bio", "label": "Author bio", "default": "<p>We write about what goes into our formula and why, in plain language, without the marketing gloss.</p>" },

    { "type": "header", "content": "Disclaimer" },
    { "type": "richtext", "id": "disclaimer", "label": "Disclaimer", "default": "<p>† These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure or prevent any disease. Always speak with your healthcare provider if you are pregnant, nursing or taking medication.</p>" },

    { "type": "header", "content": "Related posts" },
    { "type": "checkbox", "id": "show_related", "label": "Show related posts (same tag)", "default": true },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "hero_bg", "label": "Hero background", "default": "#E8533A" },
    { "type": "color", "id": "hero_text", "label": "Hero text", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E8533A" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#1F1F1F" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#4A4A4A" },
    { "type": "color", "id": "related_bg", "label": "Related posts background", "default": "#F6F4F1" }
  ]
}
{% endschema %}