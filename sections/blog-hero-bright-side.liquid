{%- comment -%}
  File: sections/blog-hero-bright-side.liquid
  "The Bright Side" blog hero — eyebrow, big heading, intro text,
  decorative stars and a row of tilted photo cards with a centre star.
  Blocks: photo (tilted polaroid card) and star (centre star with image).
{%- endcomment -%}

<style>
  #BrightHero-{{ section.id }} {
    --bh-bg: {{ section.settings.bg_color }};
    --bh-text: {{ section.settings.text_color }};
    --bh-star: {{ section.settings.star_color }};
    --bh-star-soft: {{ section.settings.star_soft_color }};
    --bh-card-border: {{ section.settings.card_border_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {%- if section.settings.heading_font -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
    #BrightHero-{{ section.id }} .bright-hero__heading {
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      font-weight: {{ section.settings.heading_font.weight }};
    }
  {%- endif -%}
</style>

<section id="BrightHero-{{ section.id }}" class="bright-hero{% if section.settings.animate %} bright-hero--animate{% endif %}">

  {%- comment -%} Decorative stars {%- endcomment -%}
  {%- if section.settings.show_deco_stars -%}
    <div class="bright-hero__deco" aria-hidden="true">
      {%- render 'bright-hero-star', class: 'bright-hero__deco-star bright-hero__deco-star--tl' -%}
      {%- render 'bright-hero-star', class: 'bright-hero__deco-star bright-hero__deco-star--tr' -%}
      {%- render 'bright-hero-star', class: 'bright-hero__deco-star bright-hero__deco-star--mr' -%}
    </div>
  {%- endif -%}

  <div class="bright-hero__inner page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="bright-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="bright-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="bright-hero__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="bright-hero__gallery">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'photo' -%}
              <figure
                class="bright-hero__card"
                style="--rot: {{ block.settings.rotation }}deg; --lift: {{ block.settings.offset_y }}px; --i: {{ forloop.index0 }};"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="bright-hero__card-link">{%- endif -%}
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 600 | image_tag:
                    loading: 'eager',
                    widths: '300, 450, 600',
                    sizes: '(min-width: 990px) 160px, 28vw',
                    alt: block.settings.image.alt | escape
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'bright-hero__placeholder' }}
                {%- endif -%}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
              </figure>

            {%- when 'star' -%}
              <div
                class="bright-hero__center-star"
                style="--rot: {{ block.settings.rotation }}deg; --i: {{ forloop.index0 }};"
                {{ block.shopify_attributes }}
              >
                {%- render 'bright-hero-star', class: 'bright-hero__center-star-shape', fill: block.settings.star_fill -%}
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 500 | image_tag:
                    class: 'bright-hero__center-star-img',
                    loading: 'eager',
                    widths: '250, 400, 500',
                    sizes: '(min-width: 990px) 140px, 24vw',
                    alt: block.settings.image.alt | escape
                  }}
                {%- endif -%}
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .bright-hero {
    position: relative;
    overflow: hidden;
    background: var(--bh-bg);
    color: var(--bh-text);
    text-align: center;
  }
  .bright-hero__inner {
    position: relative;
    z-index: 1;
  }

  /* ---------- Text ---------- */
  .bright-hero__eyebrow {
    margin: 0 0 18px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .bright-hero__heading {
    margin: 0 auto 28px;
    max-width: 14ch;
    color: var(--bh-text);
    font-size: clamp(2.6rem, 7.5vw, 5.4rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .bright-hero__text {
    max-width: 470px;
    margin: 0 auto;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
  }
  .bright-hero__text p { margin: 0; }

  /* ---------- Decorative stars ---------- */
  .bright-hero__deco {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .bright-hero__deco-star { position: absolute; }
  .bright-hero__deco-star--tl { top: 14%; left: 7%;  width: 46px; fill: var(--bh-star); }
  .bright-hero__deco-star--tr { top: 8%;  right: 5%; width: 88px; fill: var(--bh-star-soft); }
  .bright-hero__deco-star--mr { top: 42%; right: 16%; width: 26px; fill: var(--bh-star); }
  @media (max-width: 749px) {
    .bright-hero__deco-star--tl { top: 4%; left: 4%; width: 28px; }
    .bright-hero__deco-star--tr { top: 2%; right: 2%; width: 52px; }
    .bright-hero__deco-star--mr { top: 38%; right: 4%; width: 18px; }
  }

  /* ---------- Gallery ---------- */
  .bright-hero__gallery {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 48px;
  }
  .bright-hero__card {
    flex: 0 0 auto;
    width: clamp(78px, 13vw, 140px);
    aspect-ratio: 4 / 5.2;
    margin: 0;
    padding: 0;
    border: clamp(3px, 0.5vw, 5px) solid var(--bh-card-border);
    border-radius: clamp(8px, 1.2vw, 14px);
    overflow: hidden;
    background: var(--bh-card-border);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.18);
    transform: translateY(var(--lift, 0)) rotate(var(--rot, 0deg));
    transition: transform 0.35s cubic-bezier(.2,.8,.3,1.2);
  }
  .bright-hero__card:hover {
    transform: translateY(calc(var(--lift, 0px) - 8px)) rotate(0deg) scale(1.05);
  }
  .bright-hero__card-link { display: block; width: 100%; height: 100%; }
  .bright-hero__card img,
  .bright-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: calc(clamp(8px, 1.2vw, 14px) - 4px);
  }

  /* Centre star */
  .bright-hero__center-star {
    position: relative;
    flex: 0 0 auto;
    width: clamp(110px, 15vw, 175px);
    aspect-ratio: 1;
    transform: rotate(var(--rot, 0deg));
    filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.18));
  }
  .bright-hero__center-star-shape {
    width: 100%;
    height: 100%;
  }
  .bright-hero__center-star-img {
    position: absolute;
    inset: 22% 14% 18%;
    width: 72%;
    height: 60%;
    object-fit: contain;
  }

  @media (max-width: 749px) {
    .bright-hero__gallery { gap: 0; margin-top: 36px; }
    .bright-hero__card,
    .bright-hero__center-star { margin: 0 -6px; }
    .bright-hero__card:nth-child(n+6) { display: none; }
  }

  /* ---------- Entrance + float animation ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .bright-hero--animate .bright-hero__card,
    .bright-hero--animate .bright-hero__center-star {
      animation: brightHeroIn 0.7s cubic-bezier(.2,.8,.3,1.2) both;
      animation-delay: calc(var(--i) * 90ms + 150ms);
    }
    .bright-hero--animate .bright-hero__center-star-shape {
      animation: brightHeroSpin 14s linear infinite;
    }
    .bright-hero--animate .bright-hero__deco-star {
      animation: brightHeroFloat 5s ease-in-out infinite;
    }
    .bright-hero--animate .bright-hero__deco-star--tr { animation-delay: -1.5s; }
    .bright-hero--animate .bright-hero__deco-star--mr { animation-delay: -3s; }
  }
  @keyframes brightHeroIn {
    from { opacity: 0; translate: 0 40px; }
    to   { opacity: 1; translate: 0 0; }
  }
  @keyframes brightHeroFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-10px) rotate(8deg); }
  }
  @keyframes brightHeroSpin {
    0%, 100% { transform: rotate(0deg); }
    50%      { transform: rotate(10deg); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bright Side hero",
  "tag": "div",
  "class": "section",
  "max_blocks": 7,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the Kefey® team" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Bright Side" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Honest, joyful writing on feeling good every day — what's inside the star, how to keep your days steady, and the little moments that help you live full.</p>" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "nunito_sans_n8" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#E8533A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "star_color", "label": "Small stars", "default": "#FFC414" },
    { "type": "color", "id": "star_soft_color", "label": "Large faded star", "default": "#EF7563" },
    { "type": "color", "id": "card_border_color", "label": "Photo card border", "default": "#FFFFFF" },

    { "type": "header", "content": "Style" },
    { "type": "checkbox", "id": "show_deco_stars", "label": "Show decorative stars", "default": true },
    { "type": "checkbox", "id": "animate", "label": "Enable animations", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "range", "id": "rotation", "label": "Tilt", "min": -15, "max": 15, "step": 1, "unit": "°", "default": -5 },
        { "type": "range", "id": "offset_y", "label": "Vertical offset", "min": -40, "max": 40, "step": 2, "unit": "px", "default": 0 }
      ]
    },
    {
      "type": "star",
      "name": "Centre star",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image inside star", "info": "Use a transparent PNG (e.g. product gummies)" },
        { "type": "color", "id": "star_fill", "label": "Star color", "default": "#FFFFFF" },
        { "type": "range", "id": "rotation", "label": "Tilt", "min": -30, "max": 30, "step": 1, "unit": "°", "default": 0 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bright Side hero",
      "blocks": [
        { "type": "photo", "settings": { "rotation": -6, "offset_y": 6 } },
        { "type": "photo", "settings": { "rotation": 4, "offset_y": -4 } },
        { "type": "star" },
        { "type": "photo", "settings": { "rotation": -3, "offset_y": -4 } },
        { "type": "photo", "settings": { "rotation": 5, "offset_y": 6 } }
      ]
    }
  ]
}
{% endschema %}
