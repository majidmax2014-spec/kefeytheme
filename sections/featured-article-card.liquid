{%- comment -%}
  File: sections/featured-article-card.liquid
  Featured article card — image left, content right (stacks on mobile).
  All CSS is scoped to this section's ID with unique "kfa-" classes,
  so theme styles can't override the layout.
{%- endcomment -%}

{%- liquid
  assign a = section.settings.article

  assign card_image = section.settings.image
  if card_image == blank and a != blank
    assign card_image = a.image
  endif

  assign card_title = section.settings.heading
  if card_title == blank and a != blank
    assign card_title = a.title
  endif
  if card_title == blank
    assign card_title = 'Ashwagandha, explained without the jargon'
  endif

  assign card_text = section.settings.text
  if card_text == blank and a != blank
    if a.excerpt != blank
      assign card_text = a.excerpt | strip_html | truncatewords: 30
    else
      assign card_text = a.content | strip_html | truncatewords: 30
    endif
  endif

  assign card_tag = section.settings.tag_label
  if card_tag == blank and a != blank and a.tags.size > 0
    assign card_tag = a.tags.first
  endif

  assign card_url = section.settings.button_link
  if card_url == blank and a != blank
    assign card_url = a.url
  endif
  if card_url == blank
    assign card_url = '#'
  endif

  assign read_time = section.settings.read_time
  if read_time == 0 and a != blank
    assign words = a.content | strip_html | split: ' ' | size
    assign read_time = words | divided_by: 200 | at_least: 1
  endif

  assign card_alt = card_title
  if card_image != blank and card_image.alt != blank
    assign card_alt = card_image.alt
  endif
  assign card_alt = card_alt | escape

  assign sid = '#KfaCard-' | append: section.id
  assign pt_mobile = section.settings.padding_top | times: 0.6 | round
  assign pb_mobile = section.settings.padding_bottom | times: 0.6 | round
-%}

<style>
  {{ sid }} {
    --kfa-bg: {{ section.settings.bg_color }};
    --kfa-card: {{ section.settings.card_color }};
    --kfa-heading: {{ section.settings.heading_color }};
    --kfa-text: {{ section.settings.text_color }};
    --kfa-accent: {{ section.settings.accent_color }};
    --kfa-pill: {{ section.settings.pill_bg }};
    display: block;
    width: 100%;
    background: var(--kfa-bg);
    overflow: hidden;
    padding: {{ pt_mobile }}px 0 {{ pb_mobile }}px;
  }
  {{ sid }} *, {{ sid }} *::before, {{ sid }} *::after { box-sizing: border-box; }

  {{ sid }} .kfa-wrap {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 5%;
  }
  {{ sid }} .kfa-frame { position: relative; width: 100%; }

  /* ---------- Card: MOBILE = stacked ---------- */
  {{ sid }} .kfa-card {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
    background: var(--kfa-card);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.08);
  }

  {{ sid }} .kfa-media {
    position: relative;
    display: block;
    width: 100%;
    flex: 0 0 auto;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.04);
  }
  {{ sid }} .kfa-media img,
  {{ sid }} .kfa-media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  {{ sid }} .kfa-body {
    width: 100%;
    min-width: 0;
    padding: 24px 20px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  {{ sid }} .kfa-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    margin: 0 0 14px;
    background: var(--kfa-pill);
    color: var(--kfa-heading);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }
  {{ sid }} .kfa-dot {
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--kfa-accent);
  }

  {{ sid }} .kfa-title {
    margin: 0 0 12px;
    font-size: 24px;
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--kfa-heading);
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: auto;
  }
  {{ sid }} .kfa-title a { color: inherit; text-decoration: none; }
  {{ sid }} .kfa-title a:hover { color: var(--kfa-accent); }

  {{ sid }} .kfa-text {
    margin: 0 0 16px;
    max-width: 520px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--kfa-text);
  }

  {{ sid }} .kfa-meta {
    margin: 0 0 20px;
    font-size: 12px;
    font-weight: 700;
    color: var(--kfa-text);
    opacity: 0.85;
  }
  {{ sid }} .kfa-meta:empty { display: none; }

  {{ sid }} .kfa-btn {
    display: block;
    width: 100%;
    padding: 14px 24px;
    background: var(--kfa-accent);
    color: #fff;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  {{ sid }} .kfa-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
    color: #fff;
  }

  /* ---------- Doodles ---------- */
  {{ sid }} .kfa-doodles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  {{ sid }} .kfa-doodle {
    position: absolute;
    height: auto;
    max-width: none;
    display: block;
    user-select: none;
  }
  {{ sid }} .kfa-doodle--star   { top: -16px; right: -8px; width: 38px; rotate: 14deg; }
  {{ sid }} .kfa-doodle--spiral { bottom: -16px; left: -8px; width: 46px; rotate: -8deg; }
  {{ sid }} .kfa-doodle--loop   { display: none; top: 14%; left: -58px; width: 44px; rotate: -12deg; }

  @media (prefers-reduced-motion: no-preference) {
    {{ sid }} .kfa-doodle { animation: kfaFloat 6s ease-in-out infinite; }
    {{ sid }} .kfa-doodle--spiral { animation-delay: -2s; }
    {{ sid }} .kfa-doodle--loop   { animation-delay: -4s; }
  }
  @keyframes kfaFloat {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
  }

  /* ---------- Small phones up ---------- */
  @media (min-width: 480px) {
    {{ sid }} .kfa-title { font-size: 28px; }
    {{ sid }} .kfa-text  { font-size: 15px; }
    {{ sid }} .kfa-btn   { display: inline-block; width: auto; }
  }

  /* ---------- Tablet: side by side 50/50 ---------- */
  @media (min-width: 750px) {
    {{ sid }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    {{ sid }} .kfa-card { flex-direction: row; align-items: stretch; border-radius: 20px; }
    {{ sid }} .kfa-card--reverse { flex-direction: row-reverse; }
    {{ sid }} .kfa-media { width: 50%; flex: 0 0 50%; aspect-ratio: auto; min-height: 340px; }
    {{ sid }} .kfa-body  { width: 50%; flex: 0 0 50%; padding: 32px; }
    {{ sid }} .kfa-title { font-size: 30px; }
    {{ sid }} .kfa-doodle--star   { top: -26px; right: -20px; width: 56px; }
    {{ sid }} .kfa-doodle--spiral { bottom: -26px; left: -24px; width: 68px; }
  }

  /* ---------- Desktop: 54 / 46 ---------- */
  @media (min-width: 990px) {
    {{ sid }} .kfa-media { width: 54%; flex-basis: 54%; min-height: 420px; }
    {{ sid }} .kfa-body  { width: 46%; flex-basis: 46%; padding: 40px 44px; }
    {{ sid }} .kfa-title { font-size: 34px; }
    {{ sid }} .kfa-text  { font-size: 16px; }
  }
  @media (min-width: 1200px) {
    {{ sid }} .kfa-body  { padding: 48px 56px; }
    {{ sid }} .kfa-title { font-size: 38px; }
  }
  @media (min-width: 1300px) {
    {{ sid }} .kfa-doodle--star   { top: -30px; right: -24px; width: 64px; }
    {{ sid }} .kfa-doodle--spiral { bottom: -30px; left: -30px; width: 80px; }
    {{ sid }} .kfa-doodle--loop   { display: block; }
  }

  @media (hover: hover) {
    {{ sid }} .kfa-card:hover .kfa-media img { transform: scale(1.04); }
  }
</style>

<div id="KfaCard-{{ section.id }}" class="kfa-section">
  <div class="kfa-wrap">
    <div class="kfa-frame">

      {%- if section.settings.show_doodles -%}
        <div class="kfa-doodles" aria-hidden="true">
          <img class="kfa-doodle kfa-doodle--star" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_64.png?v=1793080283&width=180" alt="" width="180" height="180" loading="lazy">
          <img class="kfa-doodle kfa-doodle--spiral" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_56.png?v=1793080283&width=220" alt="" width="220" height="220" loading="lazy">
          <img class="kfa-doodle kfa-doodle--loop" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_62.png?v=1793080282&width=160" alt="" width="160" height="160" loading="lazy">
        </div>
      {%- endif -%}

      <div class="kfa-card{% if section.settings.image_position == 'right' %} kfa-card--reverse{% endif %}">

        <a href="{{ card_url }}" class="kfa-media" aria-label="{{ card_title | escape }}">
          {%- if card_image != blank -%}
            {{ card_image | image_url: width: 1600 | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1600',
              sizes: '(min-width: 990px) 50vw, (min-width: 750px) 45vw, 92vw',
              alt: card_alt
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {%- endif -%}
        </a>

        <div class="kfa-body">
          {%- if card_tag != blank -%}
            <span class="kfa-pill">
              <span class="kfa-dot" aria-hidden="true"></span>
              {{ card_tag | escape }}
            </span>
          {%- endif -%}

          <h2 class="kfa-title">
            <a href="{{ card_url }}">{{ card_title | escape }}</a>
          </h2>

          {%- if card_text != blank -%}
            <p class="kfa-text">{{ card_text }}</p>
          {%- endif -%}

          <p class="kfa-meta">
            {%- if section.settings.author != blank -%}
              {{ section.settings.author }}
            {%- elsif a != blank -%}
              By {{ a.author }}
            {%- endif -%}
            {%- if read_time > 0 %} · {{ read_time }} min read{%- endif -%}
          </p>

          {%- if section.settings.button_label != blank -%}
            <a href="{{ card_url }}" class="kfa-btn">{{ section.settings.button_label }}</a>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured article card",
  "tag": "section",
  "class": "section kfa-shopify-section",
  "settings": [
    { "type": "header", "content": "Article" },
    { "type": "article", "id": "article", "label": "Blog post", "info": "Image, title, text, tag and link fill in automatically. Use the fields below to override." },

    { "type": "header", "content": "Overrides (optional)" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "tag_label", "label": "Tag label", "default": "Star ingredients" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "author", "label": "Author line", "default": "By the Kefey® team" },
    { "type": "range", "id": "read_time", "label": "Read time (0 = auto)", "min": 0, "max": 30, "step": 1, "unit": "min", "default": 0 },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read the article" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to link to the selected post" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1F1F1F" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#555555" },
    { "type": "color", "id": "accent_color", "label": "Accent (button & dot)", "default": "#E8533A" },
    { "type": "color", "id": "pill_bg", "label": "Tag background", "default": "#FDE4DF" },

    { "type": "header", "content": "Decoration" },
    { "type": "checkbox", "id": "show_doodles", "label": "Show decorative doodles", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    { "name": "Featured article card" }
  ]
}
{% endschema %}
