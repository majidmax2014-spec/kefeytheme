{%- comment -%}
  File: sections/featured-article-card.liquid
  Featured article card — image left, content right.
  Pick a blog post to auto-fill, or override any field manually.
{%- endcomment -%}

{%- liquid
  assign a = section.settings.article

  assign card_image = section.settings.image
  if card_image == blank and a != blank
    assign card_image = a.image
  endif

  assign card_title = section.settings.heading
  if card_title == blank and a != blank
    assign card_title = a.title
  endif
  if card_title == blank
    assign card_title = 'Ashwagandha, explained without the jargon'
  endif

  assign card_text = section.settings.text
  if card_text == blank and a != blank
    if a.excerpt != blank
      assign card_text = a.excerpt | strip_html | truncatewords: 30
    else
      assign card_text = a.content | strip_html | truncatewords: 30
    endif
  endif

  assign card_tag = section.settings.tag_label
  if card_tag == blank and a != blank and a.tags.size > 0
    assign card_tag = a.tags.first
  endif

  assign card_url = section.settings.button_link
  if card_url == blank and a != blank
    assign card_url = a.url
  endif
  if card_url == blank
    assign card_url = '#'
  endif

  assign read_time = section.settings.read_time
  if read_time == 0 and a != blank
    assign words = a.content | strip_html | split: ' ' | size
    assign read_time = words | divided_by: 200 | at_least: 1
  endif

  assign card_alt = card_title
  if card_image != blank and card_image.alt != blank
    assign card_alt = card_image.alt
  endif
  assign card_alt = card_alt | escape
-%}

<style>
  #FeaturedCard-{{ section.id }} {
    --fc-bg: {{ section.settings.bg_color }};
    --fc-card: {{ section.settings.card_color }};
    --fc-heading: {{ section.settings.heading_color }};
    --fc-text: {{ section.settings.text_color }};
    --fc-accent: {{ section.settings.accent_color }};
    --fc-pill: {{ section.settings.pill_bg }};
    padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
  }
  @media (min-width: 750px) {
    #FeaturedCard-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
</style>

<section id="FeaturedCard-{{ section.id }}" class="featured-card">
  <div class="featured-card__container">
    <div class="featured-card__frame">

      {%- if section.settings.show_doodles -%}
        <div class="featured-card__doodles" aria-hidden="true">
          <img class="featured-card__doodle featured-card__doodle--star" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_64.png?v=1793080283&width=180" alt="" width="180" height="180" loading="lazy">
          <img class="featured-card__doodle featured-card__doodle--spiral" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_56.png?v=1793080283&width=220" alt="" width="220" height="220" loading="lazy">
          <img class="featured-card__doodle featured-card__doodle--loop" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_62.png?v=1793080282&width=160" alt="" width="160" height="160" loading="lazy">
        </div>
      {%- endif -%}

      <article class="featured-card__inner{% if section.settings.image_position == 'right' %} featured-card__inner--reverse{% endif %}">

        <a href="{{ card_url }}" class="featured-card__media" aria-label="{{ card_title | escape }}">
          {%- if card_image != blank -%}
            {{ card_image | image_url: width: 1600 | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1600',
              sizes: '(min-width: 990px) 50vw, (min-width: 750px) 48vw, 92vw',
              alt: card_alt,
              class: 'featured-card__img'
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'featured-card__img featured-card__placeholder' }}
          {%- endif -%}
        </a>

        <div class="featured-card__body">
          {%- if card_tag != blank -%}
            <span class="featured-card__pill">
              <span class="featured-card__dot" aria-hidden="true"></span>
              {{ card_tag | escape }}
            </span>
          {%- endif -%}

          <h2 class="featured-card__title">
            <a href="{{ card_url }}">{{ card_title | escape }}</a>
          </h2>

          {%- if card_text != blank -%}
            <p class="featured-card__text">{{ card_text }}</p>
          {%- endif -%}

          <p class="featured-card__meta">
            {%- if section.settings.author != blank -%}
              {{ section.settings.author }}
            {%- elsif a != blank -%}
              By {{ a.author }}
            {%- endif -%}
            {%- if read_time > 0 %} · {{ read_time }} min read{%- endif -%}
          </p>

          {%- if section.settings.button_label != blank -%}
            <a href="{{ card_url }}" class="featured-card__btn">{{ section.settings.button_label }}</a>
          {%- endif -%}
        </div>

      </article>
    </div>
  </div>
</section>

{% stylesheet %}
  .featured-card {
    background: var(--fc-bg);
    overflow: hidden;
  }
  .featured-card *,
  .featured-card *::before,
  .featured-card *::after { box-sizing: border-box; }

  .featured-card__container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding-left: 5%;
    padding-right: 5%;
  }
  .featured-card__frame {
    position: relative;
    width: 100%;
  }

  /* ---------- Card ---------- */
  .featured-card__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--fc-card);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.08);
  }
  .featured-card__inner > * { min-width: 0; }

  @media (min-width: 750px) {
    .featured-card__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border-radius: 20px; }
    .featured-card__inner--reverse .featured-card__media { order: 2; }
  }
  @media (min-width: 990px) {
    .featured-card__inner { grid-template-columns: minmax(0, 54fr) minmax(0, 46fr); }
    .featured-card__inner--reverse { grid-template-columns: minmax(0, 46fr) minmax(0, 54fr); }
  }

  /* ---------- Image ---------- */
  .featured-card__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: rgba(0, 0, 0, 0.04);
  }
  @media (min-width: 750px) {
    .featured-card__media { aspect-ratio: auto; min-height: 340px; }
  }
  @media (min-width: 990px) {
    .featured-card__media { min-height: 420px; }
  }
  /* Absolute so the image never dictates the card height */
  .featured-card__media .featured-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  @media (hover: hover) {
    .featured-card__inner:hover .featured-card__img { transform: scale(1.04); }
  }

  /* ---------- Content ---------- */
  .featured-card__body {
    padding: 24px 20px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  @media (min-width: 750px) {
    .featured-card__body { padding: 32px 32px; }
  }
  @media (min-width: 1200px) {
    .featured-card__body { padding: 48px 56px; }
  }

  .featured-card__pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    margin-bottom: 14px;
    background: var(--fc-pill);
    color: var(--fc-heading);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }
  .featured-card__dot {
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--fc-accent);
  }

  .featured-card__title {
    margin: 0 0 12px;
    font-size: clamp(22px, 1.2rem + 1.8vw, 38px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--fc-heading);
    overflow-wrap: break-word;
    word-break: normal;
  }
  .featured-card__title a {
    color: inherit;
    text-decoration: none;
  }
  .featured-card__title a:hover { color: var(--fc-accent); }

  .featured-card__text {
    margin: 0 0 16px;
    max-width: 520px;
    font-size: clamp(14px, 0.85rem + 0.2vw, 16px);
    line-height: 1.7;
    color: var(--fc-text);
  }

  .featured-card__meta {
    margin: 0 0 20px;
    font-size: 12px;
    font-weight: 700;
    color: var(--fc-text);
    opacity: 0.85;
  }
  .featured-card__meta:empty { display: none; }

  .featured-card__btn {
    display: inline-block;
    padding: 14px 24px;
    background: var(--fc-accent);
    color: #fff;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .featured-card__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
    color: #fff;
  }
  @media (max-width: 479px) {
    .featured-card__btn { width: 100%; }
  }

  /* ---------- Decorative doodles ---------- */
  .featured-card__doodles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .featured-card__doodle {
    position: absolute;
    height: auto;
    max-width: none;
    display: block;
    user-select: none;
  }
  .featured-card__doodle--star   { top: -18px; right: -10px; width: 40px; rotate: 14deg; }
  .featured-card__doodle--spiral { bottom: -18px; left: -10px; width: 48px; rotate: -8deg; }
  .featured-card__doodle--loop   { display: none; top: 14%; left: -58px; width: 44px; rotate: -12deg; }

  @media (min-width: 750px) {
    .featured-card__doodle--star   { top: -26px; right: -20px; width: 56px; }
    .featured-card__doodle--spiral { bottom: -26px; left: -24px; width: 68px; }
  }
  @media (min-width: 1300px) {
    .featured-card__doodle--star   { top: -30px; right: -24px; width: 64px; }
    .featured-card__doodle--spiral { bottom: -30px; left: -30px; width: 80px; }
    .featured-card__doodle--loop   { display: block; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .featured-card__doodle { animation: featuredCardDoodle 6s ease-in-out infinite; }
    .featured-card__doodle--spiral { animation-delay: -2s; }
    .featured-card__doodle--loop   { animation-delay: -4s; }
  }
  @keyframes featuredCardDoodle {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured article card",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Article" },
    { "type": "article", "id": "article", "label": "Blog post", "info": "Image, title, text, tag and link fill in automatically. Use the fields below to override." },

    { "type": "header", "content": "Overrides (optional)" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "tag_label", "label": "Tag label", "default": "Star ingredients" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "author", "label": "Author line", "default": "By the Kefey® team" },
    { "type": "range", "id": "read_time", "label": "Read time (0 = auto)", "min": 0, "max": 30, "step": 1, "unit": "min", "default": 0 },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read the article" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to link to the selected post" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1F1F1F" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#555555" },
    { "type": "color", "id": "accent_color", "label": "Accent (button & dot)", "default": "#E8533A" },
    { "type": "color", "id": "pill_bg", "label": "Tag background", "default": "#FDE4DF" },

    { "type": "header", "content": "Decoration" },
    { "type": "checkbox", "id": "show_doodles", "label": "Show decorative doodles", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    { "name": "Featured article card" }
  ]
}
{% endschema %}
