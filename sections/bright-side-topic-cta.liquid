{%- comment -%}
  File: sections/bright-side-topic-cta.liquid
  CTA banner — tinted rounded box, heading + text left, pill button right.
  Side spacing 5%.
{%- endcomment -%}

<style>
  #TopicCta-{{ section.id }} {
    --cta-section-bg: {{ section.settings.section_bg }};
    --cta-box: {{ section.settings.box_bg }};
    --cta-heading: {{ section.settings.heading_color }};
    --cta-text: {{ section.settings.text_color }};
    --cta-btn: {{ section.settings.button_bg }};
    --cta-btn-text: {{ section.settings.button_text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<section id="TopicCta-{{ section.id }}" class="topic-cta">
  <div class="topic-cta__inner">
    <div class="topic-cta__box">

      {%- comment -%} Decorative doodles (client elements) {%- endcomment -%}
      {%- if section.settings.show_doodles -%}
        <img class="topic-cta__doodle topic-cta__doodle--star" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_64.png?v=1793080283&width=120" alt="" width="120" height="120" loading="lazy" aria-hidden="true">
        <img class="topic-cta__doodle topic-cta__doodle--loop" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_62.png?v=1793080282&width=120" alt="" width="120" height="120" loading="lazy" aria-hidden="true">
      {%- endif -%}

      <div class="topic-cta__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="topic-cta__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="topic-cta__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="topic-cta__btn">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}

    </div>
  </div>
</section>

{% stylesheet %}
  .topic-cta { background: var(--cta-section-bg); }
  .topic-cta__inner {
    padding-left: 5%;
    padding-right: 5%;
  }

  .topic-cta__box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: 26px 22px;
    background: var(--cta-box);
    border-radius: 18px;
  }
  @media (min-width: 750px) {
    .topic-cta__box {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      padding: 30px 22px 30px 22px;
    }
  }
  @media (min-width: 990px) {
    .topic-cta__box { padding: 30px 22px; }
  }

  .topic-cta__heading {
    margin: 0 0 8px;
    font-size: clamp(17px, 1.6vw, 20px);
    font-weight: 800;
    line-height: 1.3;
    color: var(--cta-heading);
  }
  .topic-cta__text {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--cta-text);
  }

  .topic-cta__btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 26px;
    background: var(--cta-btn);
    color: var(--cta-btn-text);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .topic-cta__btn:hover {
    color: var(--cta-btn-text);
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(232, 83, 58, 0.3);
  }

  /* ---------- Decorative doodles (on the box corners) ---------- */
  .topic-cta__box { position: relative; }
  .topic-cta__content,
  .topic-cta__btn { position: relative; z-index: 1; }
  .topic-cta__doodle {
    position: absolute;
    height: auto;
    display: block;
    pointer-events: none;
    user-select: none;
    z-index: 2;
  }
  .topic-cta__doodle--star { top: -20px;    right: -16px; width: 46px; rotate: 14deg; }
  .topic-cta__doodle--loop { bottom: -18px; left: -14px;  width: 42px; rotate: -10deg; }

  @media (max-width: 749px) {
    .topic-cta__doodle--star { top: -14px;    right: -6px; width: 32px; }
    .topic-cta__doodle--loop { bottom: -12px; left: -6px;  width: 30px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .topic-cta__doodle {
      animation: topicCtaDoodle 6s ease-in-out infinite;
    }
    .topic-cta__doodle--loop { animation-delay: -3s; }
  }
  @keyframes topicCtaDoodle {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Topic CTA banner",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mood support, explained on one page" },
    { "type": "text", "id": "text", "label": "Text", "default": "Everything on non-drowsy, caffeine-free daily support, gathered in one place." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See mood support" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "box_bg", "label": "Box background", "default": "#E3F3F3" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1F1F1F" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#555555" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#E8533A" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" },

    { "type": "header", "content": "Decoration" },
    { "type": "checkbox", "id": "show_doodles", "label": "Show decorative doodles", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [
    { "name": "Topic CTA banner" }
  ]
}
{% endschema %}