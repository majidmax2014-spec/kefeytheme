{%- comment -%}
  File: sections/bright-side-topics.liquid
  "Pick a topic" — modern coloured topic cards with a large photo.
  Each card is a block: colour, text colour, image, title, text, link.
{%- endcomment -%}

<style>
  #BrightTopics-{{ section.id }} {
    --bt-bg: {{ section.settings.bg_color }};
    --bt-heading: {{ section.settings.heading_color }};
    --bt-text: {{ section.settings.text_color }};
    --bt-cols: {{ section.settings.columns }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<section id="BrightTopics-{{ section.id }}" class="bright-topics">

  {%- comment -%} Decorative doodles (client elements) {%- endcomment -%}
  {%- if section.settings.show_doodles -%}
    <div class="bright-topics__doodles" aria-hidden="true">
      <img class="bright-topics__doodle bright-topics__doodle--zigzag" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_61.png?v=1793080282&width=200" alt="" width="200" height="200" loading="lazy">
      <img class="bright-topics__doodle bright-topics__doodle--dot" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_65.png?v=1793080282&width=80" alt="" width="80" height="80" loading="lazy">
      <img class="bright-topics__doodle bright-topics__doodle--curve" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_59.png?v=1793080283&width=160" alt="" width="160" height="160" loading="lazy">
    </div>
  {%- endif -%}

  <div class="bright-topics__container">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="bright-topics__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="bright-topics__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="bright-topics__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="bright-topics__grid">
      {%- for block in section.blocks -%}
        {%- assign has_link = false -%}
        {%- if block.settings.link != blank -%}{%- assign has_link = true -%}{%- endif -%}

        {%- if has_link -%}
          <a href="{{ block.settings.link }}" class="bright-topics__card" style="--card-bg: {{ block.settings.bg_color }}; --card-text: {{ block.settings.text_color }};" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="bright-topics__card" style="--card-bg: {{ block.settings.bg_color }}; --card-text: {{ block.settings.text_color }};" {{ block.shopify_attributes }}>
        {%- endif -%}

            <div class="bright-topics__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 700 | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600, 700',
                  sizes: '(min-width: 990px) 20vw, 260px',
                  alt: block.settings.image.alt | default: block.settings.title | escape
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'bright-topics__placeholder' }}
              {%- endif -%}
              <span class="bright-topics__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            </div>

            <div class="bright-topics__body">
              {%- if block.settings.title != blank -%}
                <h3 class="bright-topics__title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <p class="bright-topics__text">{{ block.settings.text }}</p>
              {%- endif -%}

              {%- if block.settings.link_label != blank or has_link -%}
                <div class="bright-topics__footer">
                  {%- if block.settings.link_label != blank -%}
                    <span class="bright-topics__link">{{ block.settings.link_label }}</span>
                  {%- endif -%}
                  {%- if has_link -%}
                    <span class="bright-topics__arrow" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

        {%- if has_link -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% stylesheet %}
  .bright-topics {
    position: relative;
    overflow: hidden;
    background: var(--bt-bg);
  }
  .bright-topics__container {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 0 5%;
    box-sizing: border-box;
  }

  /* ---------- Header ---------- */
  .bright-topics__header {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 40px;
  }
  .bright-topics__heading {
    margin: 0 0 14px;
    font-size: clamp(28px, 3.4vw, 42px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--bt-heading);
  }
  .bright-topics__sub {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--bt-text);
  }

  /* ---------- Grid ---------- */
  /* Mobile + tablet: swipe */
  .bright-topics__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 250px;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 6px 2px 28px;
    scrollbar-width: none;
  }
  .bright-topics__grid::-webkit-scrollbar { display: none; }

  /* Desktop: all cards in one row */
  @media (min-width: 990px) {
    .bright-topics__grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--bt-cols), minmax(0, 1fr));
      gap: 20px;
      overflow: visible;
      padding: 6px 0 28px;
    }
  }

  /* ---------- Card ---------- */
  .bright-topics__card {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: 12px 12px 20px;
    background: var(--card-bg);
    color: var(--card-text);
    border-radius: 24px;
    text-decoration: none;
    transition: transform 0.35s cubic-bezier(.2,.8,.3,1.2), box-shadow 0.35s ease;
  }
  .bright-topics__card:hover {
    transform: translateY(-8px);
    box-shadow: 0 22px 40px rgba(0, 0, 0, 0.14);
    color: var(--card-text);
  }

  /* Photo */
  .bright-topics__media {
    position: relative;
    aspect-ratio: 4 / 4.4;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.25);
  }
  .bright-topics__media img,
  .bright-topics__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .bright-topics__card:hover .bright-topics__media img { transform: scale(1.06); }

  .bright-topics__num {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 5px 9px;
    background: rgba(255, 255, 255, 0.92);
    color: #1F1F1F;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  /* Content */
  .bright-topics__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 18px 8px 0;
  }
  .bright-topics__title {
    margin: 0 0 8px;
    color: inherit;
    font-size: clamp(19px, 1.5vw, 23px);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .bright-topics__text {
    margin: 0 0 20px;
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.6;
    opacity: 0.92;
  }

  .bright-topics__footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px solid currentColor;
    border-top-color: color-mix(in srgb, currentColor 25%, transparent);
  }
  .bright-topics__link {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .bright-topics__arrow {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin-left: auto;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    color: #1F1F1F;
    transition: transform 0.3s ease;
  }
  .bright-topics__card:hover .bright-topics__arrow { transform: rotate(45deg); }

  /* ---------- Decorative doodles ---------- */
  .bright-topics__doodles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .bright-topics__doodle {
    position: absolute;
    height: auto;
    display: block;
    user-select: none;
  }
  .bright-topics__doodle--zigzag { top: 36px;  left: 9%;   width: 76px; rotate: -8deg; }
  .bright-topics__doodle--dot    { top: 108px; left: 16%;  width: 16px; }
  .bright-topics__doodle--curve  { top: 24px;  right: 11%; width: 36px; rotate: 24deg; }

  @media (max-width: 989px) {
    .bright-topics__doodle--zigzag { left: 4%; width: 56px; }
    .bright-topics__doodle--dot    { left: 11%; }
    .bright-topics__doodle--curve  { right: 6%; width: 28px; }
  }
  @media (max-width: 749px) {
    .bright-topics__doodle--dot { display: none; }
    .bright-topics__doodle--zigzag { top: 12px; left: 4%; width: 40px; }
    .bright-topics__doodle--curve  { top: 8px; right: 5%; width: 22px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .bright-topics__doodle {
      animation: brightTopicsDoodle 6s ease-in-out infinite;
    }
    .bright-topics__doodle--dot   { animation-delay: -2s; }
    .bright-topics__doodle--curve { animation-delay: -4s; }
  }
  @keyframes brightTopicsDoodle {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bright Side topics",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick a topic" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Five places to start, depending on what's on your mind today." },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 3, "max": 6, "step": 1, "default": 5 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1F1F1F" },
    { "type": "color", "id": "text_color", "label": "Subheading", "default": "#555555" },

    { "type": "header", "content": "Decoration" },
    { "type": "checkbox", "id": "show_doodles", "label": "Show decorative doodles", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait photo works best (around 4:4.4)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Good Moods" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Mood, focus and staying steady when the week gets busy." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Link", "info": "Tip: /blogs/news/tagged/good-moods shows posts with that tag" },
        { "type": "color", "id": "bg_color", "label": "Card color", "default": "#3FB8B2" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bright Side topics",
      "blocks": [
        { "type": "topic", "settings": { "title": "Good Moods", "text": "Mood, focus and staying steady when the week gets busy.", "bg_color": "#3FB8B2", "text_color": "#FFFFFF" } },
        { "type": "topic", "settings": { "title": "Energy & Rest", "text": "Steady energy, restful evenings, and the daily habits in between.", "bg_color": "#8BC34F", "text_color": "#FFFFFF" } },
        { "type": "topic", "settings": { "title": "Star Ingredients", "text": "Every botanical explained, and how the formula comes together.", "bg_color": "#E8533A", "text_color": "#FFFFFF" } },
        { "type": "topic", "settings": { "title": "Live Full", "text": "The little rituals and joyful moments that make every day feel lighter.", "bg_color": "#FFC700", "text_color": "#1F1F1F" } },
        { "type": "topic", "settings": { "title": "Kefey Stories", "text": "Our story, our people, our impact and the latest news.", "bg_color": "#52B0AE", "text_color": "#FFFFFF" } }
      ]
    }
  ]
}
{% endschema %}