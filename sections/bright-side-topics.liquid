{%- comment -%}
  File: sections/bright-side-topics.liquid
  "Pick a topic" — open layout (no cards): round photo with a coloured
  offset disc, title, text and an underlined link.
  Topics sit in a swipeable carousel with arrows + progress bar.
  Each topic is a block: colour, image, title, text, link.
{%- endcomment -%}

<style>
  #BrightTopics-{{ section.id }} {
    --bt-bg: {{ section.settings.bg_color }};
    --bt-heading: {{ section.settings.heading_color }};
    --bt-text: {{ section.settings.text_color }};
    --bt-cols: {{ section.settings.columns }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<section id="BrightTopics-{{ section.id }}" class="bright-topics">

  {%- comment -%} Decorative doodles (client elements) {%- endcomment -%}
  {%- if section.settings.show_doodles -%}
    <div class="bright-topics__doodles" aria-hidden="true">
      <img class="bright-topics__doodle bright-topics__doodle--zigzag" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_61.png?v=1793080282&width=200" alt="" width="200" height="200" loading="lazy">
      <img class="bright-topics__doodle bright-topics__doodle--dot" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_65.png?v=1793080282&width=80" alt="" width="80" height="80" loading="lazy">
      <img class="bright-topics__doodle bright-topics__doodle--curve" src="https://cdn.shopify.com/s/files/1/0752/1556/9124/files/Untitled_design_59.png?v=1793080283&width=160" alt="" width="160" height="160" loading="lazy">
    </div>
  {%- endif -%}

  <div class="bright-topics__container">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="bright-topics__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="bright-topics__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="bright-topics__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <bright-topics-slider class="bright-topics__slider">
      <div class="bright-topics__list" data-track>
        {%- for block in section.blocks -%}
          {%- assign has_link = false -%}
          {%- if block.settings.link != blank -%}{%- assign has_link = true -%}{%- endif -%}

          {%- if has_link -%}
            <a href="{{ block.settings.link }}" class="bright-topics__item" style="--topic: {{ block.settings.bg_color }};" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="bright-topics__item" style="--topic: {{ block.settings.bg_color }};" {{ block.shopify_attributes }}>
          {%- endif -%}

              <div class="bright-topics__visual">
                <span class="bright-topics__disc" aria-hidden="true"></span>
                <div class="bright-topics__photo">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 800 | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800',
                      sizes: '(min-width: 990px) 240px, 200px',
                      alt: block.settings.image.alt | default: block.settings.title | escape
                    }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'bright-topics__placeholder' }}
                  {%- endif -%}
                </div>
              </div>

              {%- if block.settings.title != blank -%}
                <h3 class="bright-topics__title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <p class="bright-topics__text">{{ block.settings.text }}</p>
              {%- endif -%}

              {%- if block.settings.link_label != blank -%}
                <span class="bright-topics__link">
                  {{ block.settings.link_label }}
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
                </span>
              {%- endif -%}

          {%- if has_link -%}</a>{%- else -%}</div>{%- endif -%}
        {%- endfor -%}
      </div>

      <div class="bright-topics__controls" data-controls>
        <button type="button" class="bright-topics__arrow" data-prev aria-label="Previous topics">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M11 18l-6-6 6-6"/></svg>
        </button>
        <div class="bright-topics__progress" aria-hidden="true">
          <span class="bright-topics__progress-bar" data-bar></span>
        </div>
        <button type="button" class="bright-topics__arrow" data-next aria-label="Next topics">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </bright-topics-slider>

  </div>
</section>

{% javascript %}
  if (!customElements.get('bright-topics-slider')) {
    customElements.define('bright-topics-slider', class extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prev = this.querySelector('[data-prev]');
        this.next = this.querySelector('[data-next]');
        this.bar = this.querySelector('[data-bar]');
        this.controls = this.querySelector('[data-controls]');
        if (!this.track) return;

        this.update = this.update.bind(this);
        this.prev.addEventListener('click', () => this.go(-1));
        this.next.addEventListener('click', () => this.go(1));
        this.track.addEventListener('scroll', this.update, { passive: true });
        window.addEventListener('resize', this.update);
        this.update();
      }
      disconnectedCallback() {
        window.removeEventListener('resize', this.update);
      }
      step() {
        const item = this.track.querySelector('.bright-topics__item');
        if (!item) return this.track.clientWidth;
        const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
        return item.getBoundingClientRect().width + gap;
      }
      go(dir) {
        this.track.scrollBy({ left: dir * this.step(), behavior: 'smooth' });
      }
      update() {
        const t = this.track;
        const max = t.scrollWidth - t.clientWidth;
        const scrollable = max > 4;
        this.controls.hidden = !scrollable;
        if (!scrollable) return;

        this.prev.disabled = t.scrollLeft <= 4;
        this.next.disabled = t.scrollLeft >= max - 4;

        const size = (t.clientWidth / t.scrollWidth) * 100;
        const pos = (t.scrollLeft / max) * (100 - size);
        this.bar.style.width = size + '%';
        this.bar.style.left = pos + '%';
      }
    });
  }
{% endjavascript %}

{% stylesheet %}
  .bright-topics {
    position: relative;
    overflow: hidden;
    background: var(--bt-bg);
  }
  .bright-topics__container {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 0 5%;
    box-sizing: border-box;
  }

  /* ---------- Header ---------- */
  .bright-topics__header {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 44px;
  }
  .bright-topics__heading {
    margin: 0 0 14px;
    font-size: clamp(28px, 3.4vw, 42px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--bt-heading);
  }
  .bright-topics__sub {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--bt-text);
  }

  /* ---------- Carousel ---------- */
  .bright-topics__slider { display: block; }

  .bright-topics__list {
    --gap: 20px;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scroll-padding-left: 14px;
    padding: 6px 14px 22px;
    margin: 0 -14px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .bright-topics__list::-webkit-scrollbar { display: none; }

  /* Mobile: ~1.6 items visible so users see there is more */
  .bright-topics__item { flex: 0 0 60%; }

  /* Tablet: 3 visible */
  @media (min-width: 750px) {
    .bright-topics__list { --gap: 28px; }
    .bright-topics__item { flex: 0 0 calc((100% - 2 * var(--gap)) / 3); }
  }

  /* Desktop: "Topics per row" visible */
  @media (min-width: 990px) {
    .bright-topics__list { --gap: 32px; }
    .bright-topics__item {
      flex: 0 0 calc((100% - (var(--bt-cols) - 1) * var(--gap)) / var(--bt-cols));
    }
  }

  /* Controls */
  .bright-topics__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 18px;
  }
  .bright-topics__controls[hidden] { display: none; }

  .bright-topics__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 2px solid var(--bt-heading);
    border-radius: 50%;
    background: transparent;
    color: var(--bt-heading);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
  }
  .bright-topics__arrow:hover:not(:disabled) {
    background: var(--bt-heading);
    color: var(--bt-bg);
    transform: scale(1.05);
  }
  .bright-topics__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .bright-topics__progress {
    position: relative;
    width: 140px;
    height: 4px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }
  .bright-topics__progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 30%;
    border-radius: 999px;
    background: var(--bt-heading);
    transition: left 0.15s linear, width 0.2s ease;
  }

  @media (max-width: 749px) {
    .bright-topics__arrow { width: 40px; height: 40px; }
    .bright-topics__progress { width: 110px; }
  }

  /* ---------- Topic item ---------- */
  .bright-topics__item {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--bt-heading);
    text-decoration: none;
  }
  .bright-topics__item:hover { color: var(--bt-heading); }

  /* Round photo with coloured offset disc */
  .bright-topics__visual {
    position: relative;
    width: 100%;
    max-width: 220px;
    aspect-ratio: 1;
    margin-bottom: 26px;
  }
  .bright-topics__disc {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--topic);
    transform: translate(10px, 10px);
    transition: transform 0.4s cubic-bezier(.2,.8,.3,1.2);
  }
  .bright-topics__photo {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: var(--topic);
    box-shadow: 0 0 0 5px var(--bt-bg);
  }
  .bright-topics__photo img,
  .bright-topics__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .bright-topics__item:hover .bright-topics__disc { transform: translate(-10px, 12px); }
  .bright-topics__item:hover .bright-topics__photo img { transform: scale(1.07); }

  .bright-topics__title {
    margin: 0 0 8px;
    color: inherit;
    font-size: clamp(19px, 1.5vw, 23px);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .bright-topics__text {
    margin: 0 0 16px;
    max-width: 240px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--bt-text);
  }

  .bright-topics__link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-bottom: 4px;
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bt-heading);
    background: linear-gradient(var(--topic), var(--topic)) left bottom / 100% 3px no-repeat;
  }
  .bright-topics__link svg { transition: transform 0.25s ease; }
  .bright-topics__item:hover .bright-topics__link svg { transform: translateX(4px); }

  /* ---------- Decorative doodles ---------- */
  .bright-topics__doodles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .bright-topics__doodle {
    position: absolute;
    height: auto;
    display: block;
    user-select: none;
  }
  .bright-topics__doodle--zigzag { top: 36px;  left: 9%;   width: 76px; rotate: -8deg; }
  .bright-topics__doodle--dot    { top: 108px; left: 16%;  width: 16px; }
  .bright-topics__doodle--curve  { top: 24px;  right: 11%; width: 36px; rotate: 24deg; }

  @media (max-width: 989px) {
    .bright-topics__doodle--zigzag { left: 4%; width: 56px; }
    .bright-topics__doodle--dot    { left: 11%; }
    .bright-topics__doodle--curve  { right: 6%; width: 28px; }
  }
  @media (max-width: 749px) {
    .bright-topics__doodle--dot { display: none; }
    .bright-topics__doodle--zigzag { top: 12px; left: 4%; width: 40px; }
    .bright-topics__doodle--curve  { top: 8px; right: 5%; width: 22px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .bright-topics__doodle {
      animation: brightTopicsDoodle 6s ease-in-out infinite;
    }
    .bright-topics__doodle--dot   { animation-delay: -2s; }
    .bright-topics__doodle--curve { animation-delay: -4s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bright-topics__list { scroll-behavior: auto; }
  }
  @keyframes brightTopicsDoodle {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bright Side topics",
  "tag": "div",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick a topic" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Five places to start, depending on what's on your mind today." },
    { "type": "range", "id": "columns", "label": "Topics visible on desktop", "min": 3, "max": 6, "step": 1, "default": 5, "info": "Extra topics scroll in the carousel" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#FFF4E6" },
    { "type": "color", "id": "heading_color", "label": "Heading, titles & arrows", "default": "#1F1F1F" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#555555" },

    { "type": "header", "content": "Decoration" },
    { "type": "checkbox", "id": "show_doodles", "label": "Show decorative doodles", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square photo works best" },
        { "type": "text", "id": "title", "label": "Title", "default": "Good Moods" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Mood, focus and staying steady when the week gets busy." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Link", "info": "Tip: /blogs/news/tagged/good-moods shows posts with that tag" },
        { "type": "color", "id": "bg_color", "label": "Topic color", "info": "Used for the circle behind the photo and the link underline", "default": "#3FB8B2" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bright Side topics",
      "blocks": [
        { "type": "topic", "settings": { "title": "Good Moods", "text": "Mood, focus and staying steady when the week gets busy.", "bg_color": "#3FB8B2" } },
        { "type": "topic", "settings": { "title": "Energy & Rest", "text": "Steady energy, restful evenings, and the daily habits in between.", "bg_color": "#8BC34F" } },
        { "type": "topic", "settings": { "title": "Star Ingredients", "text": "Every botanical explained, and how the formula comes together.", "bg_color": "#E8533A" } },
        { "type": "topic", "settings": { "title": "Live Full", "text": "The little rituals and joyful moments that make every day feel lighter.", "bg_color": "#FFC700" } },
        { "type": "topic", "settings": { "title": "Kefey Stories", "text": "Our story, our people, our impact and the latest news.", "bg_color": "#52B0AE" } }
      ]
    }
  ]
}
{% endschema %}